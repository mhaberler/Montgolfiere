    "update-browserslist-db": "^1.2.3",
    "vue": "3.5.40",
    "vue-grid-layout": "^2.4.0",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
