    "@ionic/remote-log": "^0.0.2",
    "@leadscout/http": "^7.0.0",
    "@maxel01/vue-leaflet": "^1.0.0-beta.7",
    "@mhaberler/capacitor-barometer": "2.0.1",
    "@mhaberler/capacitor-zeroconf-nsd": "^5.0.5",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@turf/distance": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@types/qrcode": "^1.5.6",
    "@types/suncalc": "^1.9.2",
    "@types/yup": "^0.32.0",
    "@vueuse/components": "^14.3.0",
    "@vueuse/core": "^14.3.0",
    "canvas-gauges": "^2.1.7",
    "capacitor-set-version": "^2.2.0",
    "core-js": "^3.49.0",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "install": "^0.13.0",
    "leaflet": "2.0.0-alpha.1",
    "mathjs": "^15.2.0",
    "meteojs": "^1.17.3",
    "mqtt": "5.15.2",
    "pmtiles": "^4.4.1",
    "postcss": "^8.5.23",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "rimraf": "^6.1.3",
    "sass": "1.102.0",
