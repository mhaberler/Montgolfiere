# Local signing settings. Copy to .env (gitignored) and fill in.
# Push them to GitHub Actions secrets with scripts/sync-app-secrets.sh.
# See BUILD.md.

# --- iOS: App Store Connect API key (Admin role — needed for cloud signing) ---
ASC_KEY_PATH=~/.secrets.d/AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# --- Android: release/upload keystore ---
ANDROID_KEYSTORE_PATH=~/.secrets.d/upload-key.keystore
ANDROID_KEYSTORE_PASSWORD=*****
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=*****

# --- Vite build-time values, baked into the web bundle ---
VITE_OPENAIP_KEY=
VITE_MQTT_BROKER_URL=
VITE_MQTT_BROKER_USER=
VITE_MQTT_BROKER_PASSWORD=
VITE_MQTT_BROKER_PORT=

# --- Google Play (deferred: no Play upload yet) ---
# GOOGLE_PLAY_JSON_KEY_PATH=~/.secrets.d/play.json
